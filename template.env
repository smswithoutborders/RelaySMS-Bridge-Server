# Server Configuration
# MODE: Set to 'production' or 'development'
MODE=development

# gRPC Configuration
# GRPC_HOST: Use 127.0.0.1 for reverse proxy setup, 0.0.0.0 to expose directly
GRPC_HOST=127.0.0.1
GRPC_PORT=10000
GRPC_SSL_PORT=10001

# SSL Configuration
SSL_CERTIFICATE_FILE=
SSL_CERTIFICATE_KEY_FILE=

# Vault gRPC Configuration
# Connection to RelaySMS Vault services
VAULT_GRPC_HOST=localhost
VAULT_GRPC_PORT=8000
VAULT_GRPC_SSL_PORT=8001
VAULT_GRPC_INTERNAL_PORT=8443
VAULT_GRPC_INTERNAL_SSL_PORT=8444

# Database Configuration
# Use MySQL or SQLite (leave MySQL vars empty to use SQLite)
MYSQL_HOST=127.0.0.1
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=relaysms_bridge_server
SQLITE_DATABASE_PATH=data/bridges.sqlite

# Bridge Email Configuration
BRIDGE_SMTP_SERVER=
BRIDGE_SMTP_PORT=587
BRIDGE_SMTP_USERNAME=
BRIDGE_SMTP_PASSWORD=

BRIDGE_IMAP_SERVER=
BRIDGE_IMAP_PORT=993
BRIDGE_IMAP_USERNAME=
BRIDGE_IMAP_PASSWORD=
BRIDGE_IMAP_MAIL_FOLDER=INBOX

# SimpleLogin Configuration (Optional)
SL_API_KEY=
SL_PRIMARY_EMAIL=
SL_PRIMARY_DOMAIN=

# Twilio Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Development/Testing
MOCK_REPLY_SMS=false

# Logging
LOG_LEVEL=info

# Sentry Configuration (Optional)
SENTRY_DSN=
